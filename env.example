# Copy to .env and adjust. Every value here is optional; these are the defaults.

# --- LLM: ollama (local), anthropic or openai ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Router: rules (fast, deterministic), semantic (embedding examples) or llm ---
ROUTER_MODE=rules

# --- Embeddings: sentence-transformers, ollama (nomic-embed-text) or hashing (offline) ---
EMBEDDING_BACKEND=sentence-transformers
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=nomic-embed-text
TOP_K=4
CHUNK_SIZE=120
CHUNK_OVERLAP=30

# --- Churn prediction service (churn-api) ---
CHURN_API_URL=http://localhost:5000
CHURN_API_TIMEOUT=5

# --- Paths (relative to the project root by default) ---
# KB_DIR=data/knowledge_base
# CHROMA_DIR=data/chroma
# CUSTOMER_DB=data/customers.db
# RUN_LOG=logs/runs.jsonl
